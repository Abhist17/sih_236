# Public URL encoded in QR codes (use your LAN IP / domain so phones can scan)
PACKAI_PUBLIC_URL=http://localhost:8000
# Secret used to encrypt custodial actor keys (auto-generated in data/.secret_key if unset)
PACKAI_SECRET_KEY=
# Proof-of-work difficulty (leading hex zeros) for PackChain blocks
PACKAI_POW_DIFFICULTY=3
# Optional: anchor PackChain to Polygon Amoy (pip install web3; deploy with blockchain/deploy.py)
PACKAI_EVM_RPC_URL=
PACKAI_EVM_PRIVATE_KEY=
PACKAI_EVM_CONTRACT=
PACKAI_EVM_CHAIN_ID=80002
